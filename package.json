    "client-zip": "2.5.1",
    "cn": "^0.3.0",
    "css-tree": "3.2.1",
    "fontkit": "2.0.4",
    "geist": "1.7.2",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "playwright-core": "1.63.0",
