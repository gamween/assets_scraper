# Copy to .env.local and fill in what you need. Every value is optional in development.

# HMAC key for signed /api/asset URLs, at least 32 characters. Required in production.
ASSET_URL_SECRET=
# Set to 1 to turn scanning off (kill switch).
SCAN_DISABLED=
# When set, scans require this access code.
ACCESS_CODE=
# Scans allowed per day across the app (default 80).
SCANS_PER_DAY=
# Scans allowed per month across the app (default 800).
SCANS_PER_MONTH=
# Bytes the asset proxy may serve per day (default 300 MB).
PROXY_BYTES_PER_DAY=
# Comma-separated hosts the app is served from, accepted as the request Origin.
APP_HOSTS=
# Upstash Redis REST URL for the budget store (in-memory counters without it).
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token, used with UPSTASH_REDIS_REST_URL.
UPSTASH_REDIS_REST_TOKEN=
# Operator token (at least 32 characters) sent as x-ops-token to skip BotID and the scan budget.
OPS_TOKEN=
# Tests only: comma-separated host:port pairs that may reach private addresses. Never set in production.
SCAN_TEST_ALLOW_HOSTS=
