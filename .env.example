# Copy to .env.local and fill in what you need. Every value is optional in development.
# Only Next reads .env.local: export a variable in the shell for vitest, the CLI and the MCP server.

# HMAC key for signed /api/asset URLs, at least 32 characters. Required in production.
ASSET_URL_SECRET=
# Set to 1 to turn scanning off (kill switch).
SCAN_DISABLED=
# When set, scans require this access code.
ACCESS_CODE=
# Operator token (at least 32 characters) sent as x-ops-token to skip BotID and the scan budget.
OPS_TOKEN=
# Comma-separated bearer tokens for /api/v1, one per client, each at least 24 characters (shorter ones are ignored).
# Without one, every /api/v1 call answers 401.
AGENT_TOKENS=
# Bytes one /api/v1/assets.zip response may serve (default 64 MB).
AGENT_ZIP_MAX_BYTES=
# Scans allowed per day across the app (default 80).
SCANS_PER_DAY=
# Scans allowed per month across the app (default 800).
SCANS_PER_MONTH=
# Scans allowed per day from one client address (default 20). Raise it when a shared NAT has to share one address.
SCANS_PER_IP_PER_DAY=
# Bytes the asset proxy may serve per day (default 300 MB).
PROXY_BYTES_PER_DAY=
# Comma-separated extra hosts of the app (a custom domain) that scans and fetches refuse; not an Origin allowlist.
APP_HOSTS=
# Upstash Redis REST URL for the budget store, whose counters are atomic. Without it: the Vercel Runtime Cache on
# Vercel (shared, not atomic), in-memory counters elsewhere.
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token, used with UPSTASH_REDIS_REST_URL.
UPSTASH_REDIS_REST_TOKEN=
# Chrome for local scans, when it is not where Google Chrome installs itself. Ignored on Vercel.
CHROME_EXECUTABLE_PATH=
# Tests only: comma-separated host:port pairs that may reach private addresses. Never set in production.
SCAN_TEST_ALLOW_HOSTS=

# Every limit in src/server/config/limits.ts can be set here too, by the SCREAMING_SNAKE_CASE of its key
# (QUEUE_WAIT_MS), and every limit in src/agent/limits.ts with an AGENT_ prefix (AGENT_MAX_FILES).
